# Copy to .env.local and fill in real values. Never commit .env.local.
# Server-only base URL of the backend. Used by next.config rewrites (API proxy)
# and Server Components. NEVER prefix with NEXT_PUBLIC_.
BACKEND_URL=https://docappoint-backend-tau.vercel.app

# Public URL of this frontend (used for metadata/absolute URLs).
NEXT_PUBLIC_APP_URL=http://localhost:5002
